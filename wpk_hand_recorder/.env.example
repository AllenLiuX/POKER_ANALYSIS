# Copy to .env and fill the real value. Never commit .env.

# ModelHub credential and deployment
WPK_LLM_API_KEY=
WPK_LLM_MODEL=gpt-5.6-sol

# Optional overrides
# Server-enforced assistance policy:
# operator_approved_live | post_session | static_history | capture_only
# The default preserves the existing live dashboard behavior. Only use live
# assistance after confirming the current room permits it.
WPK_ASSISTANCE_MODE=operator_approved_live
# WPK_LLM_ENDPOINT=https://example.test/openai/deployments/custom/chat/completions
WPK_LLM_TIMEOUT_SECONDS=12
WPK_LLM_PROFILE_TIMEOUT_SECONDS=30
WPK_LLM_MAX_COMPLETION_TOKENS=800
WPK_LLM_PROFILE_MAX_COMPLETION_TOKENS=2000
WPK_LLM_REASONING_EFFORT=low
WPK_LLM_DEEP_TIMEOUT_SECONDS=20
WPK_LLM_DEEP_MAX_COMPLETION_TOKENS=2000
WPK_LLM_DEEP_REASONING_EFFORT=medium
WPK_INFERENCE_EXACT_TEMPLATE=exact-action-v1
WPK_INFERENCE_RANGE_TEMPLATE=full-range-v1
# Keep false in production; offline eval can still address registered candidates.
WPK_INFERENCE_ALLOW_EXPERIMENTAL=false

# Optional, only after confirming the current room's squid settlement rules
# WPK_SQUID_VALUE=40
# WPK_SQUID_PAYOUT_BASIS=awarded
