# 复制为 .env.local。指向后端 API（本地默认 127.0.0.1:8000）。
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Supabase（登录 + 云同步；留空则自动降级为本地模式）。设置步骤见 docs/SUPABASE.md
NEXT_PUBLIC_SUPABASE_URL=
# 新版 publishable key（sb_publishable_...）优先；或用旧版 anon key，二选一。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
