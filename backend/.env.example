# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，绝不提交。

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- LLM 网关 (model_client) ----
# 共享网关 AK（gpt-5.x / gemini）。公网环境用 office。
MODEL_GATEWAY_KEY=
MODEL_GATEWAY_KEY_GPT4O=
MODEL_CLIENT_NETWORK=office

# ---- OpenAI 兜底 / 直连 ----
OPENAI_API_KEY=
# 模型选型（2026-08，均支持 vision）：
#   gpt-5.6-terra  $2/$12   —— 智能/成本平衡，推荐默认（比 gpt-4o 更强且输入更便宜）
#   gpt-5.6-luna   $0.2/$1.2 —— 高性价比，适合走量
#   gpt-5.6-sol    $5/$30   —— 最强，重推理时用
#   gpt-4o         $2.5/$10 —— 旧款，非推理、延迟低
# 注意：gpt-5.x 为推理模型，provider 会自动改用 max_completion_tokens 且不发 temperature。
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-5.6-terra
# 生产（如 AWS）连不通公司网关时置 true：文本与视觉都直连 OpenAI，完全跳过网关，
# 避免截图识别逐个视觉模型等到超时。需同时配好 OPENAI_API_KEY。
LLM_FORCE_OPENAI=false

# ---- Supabase（Phase 4 接入；新建独立项目）----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 知识库联网搜索（Tavily，RAG 接地）----
# 在 https://tavily.com 注册免费 tier（1000 次/月）。留空 = 知识库接地自动关闭，
# AI 分析退回纯统计接地，功能不受影响。可直接复用 ~/ai_study_platform 里同一个 key。
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
# 知识库：把检索到的德州策略片段按「概念」持久化到本地 SQLite，TTL 内复用不重复搜索。
KB_ENABLED=true
KB_TTL_DAYS=30
KB_PATH=data/poker_kb.sqlite3
