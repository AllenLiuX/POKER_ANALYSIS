# systemd 单元模板：前端（Next.js next start），开机自启 + 崩溃自动重启。
#
# 安装（把 __REPO_ROOT__ 换成实际克隆路径，__USER__ 换成运行用户，如 ubuntu）：
#   sudo cp deploy/systemd/poker-frontend.service /etc/systemd/system/
#   sudo sed -i "s#__REPO_ROOT__#/home/ubuntu/poker_analysis#g; s#__USER__#ubuntu#g" \
#       /etc/systemd/system/poker-frontend.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now poker-frontend
#   systemctl status poker-frontend
#
# 前提：已跑过一次 deploy/frontend.sh（已 npm ci 且 npm run build 生成 .next 产物）。
# 注意：NEXT_PUBLIC_API_BASE_URL 在构建时烘焙，改地址后需重新 build 再重启本服务。

[Unit]
Description=Poker Analysis Frontend (Next.js)
After=network.target poker-backend.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_ROOT__/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npm run start -- -p 3000 -H 0.0.0.0
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
