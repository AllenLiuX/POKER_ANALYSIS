# 复制为 deploy/config.env 以覆盖默认部署配置（config.env 已被 .gitignore 忽略）。
#   cp deploy/config.env.example deploy/config.env
# 所有部署脚本（backend.sh / frontend.sh / deploy.sh）会自动加载它。

# ---- 后端（FastAPI / uvicorn）----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2

# ---- 前端（Next.js）----
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# 浏览器直接请求后端 API，因此这里必须填「浏览器能访问到的」后端地址。
# 单机部署示例（用你的 AWS 公网 IP 或域名替换）：
#   NEXT_PUBLIC_API_BASE_URL=http://12.34.56.78:8000
# 若用 nginx 反向代理到同域名下的 /api，可写：
#   NEXT_PUBLIC_API_BASE_URL=https://your-domain.com
# ⚠️ 该值在「构建时」烘焙进前端产物，修改后必须重新 build。
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ---- 其它 ----
# PYTHON_BIN=python3
# LOG_DIR=/var/log/poker
# HEALTH_TIMEOUT=60
